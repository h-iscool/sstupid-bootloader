section .text
[bits 32]

global real_mode_interrupt
real_mode_interrupt:

push ebp
mov ebp, esp
pusha ;;pushes AX CX DX BX SP BP SI DI so we dont broked anythin

;; [ebp+0x8] = uint8_t interupt num
;; [esb+0xc] = ptr to struct with regs that are uint16_t


mov dl, [ebp+0x8] 
mov [interupt_holder], dl ;; keep bios int here for later (in 16bit area so we can access it there (ugggh ts sucks so bad))


mov esi, [ebp+0xc] ;; now esi holds the ptr a la bullshit struct


mov ax, [esi+0x0]
mov [ax_holder], ax
mov ax, [esi+0x2]
mov [bx_holder], ax 
mov ax, [esi+0x4]
mov [cx_holder], ax
mov ax, [esi+0x6]
mov [dx_holder], ax
mov ax, [esi+0x8]
mov [si_holder], ax
mov ax, [esi+0xa]
mov [di_holder], ax
mov ax, [esi+0xc]
mov [ds_holder], ax
mov ax, [esi+0xe]
mov [es_holder], ax


;;ok nows we kills halves of tehs 32bists

;; i love copy pasting gdt cause 2 vscode windows is 2 too many (im already at 1)

