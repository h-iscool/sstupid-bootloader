[bits 32]
.Protected_Mode_2nd_Entry:
;;getitng back 32bit regs :P
mov ax, 0x10
mov ds, ax
mov es, ax
mov ss, ax ;; lmao i almorst forgot abt stack seg for a sec

;write to that buffer struct thing
mov esi, [ebp+0xc]
mov ax, [ax_holder]
mov [esi+0x0], ax
mov ax, [bx_holder]
mov [esi+0x2], ax
mov ax, [cx_holder]
mov [esi+0x4], ax
mov ax, [dx_holder]
mov [esi+0x6], ax
mov ax, [di_holder]
mov [esi+0x8], ax
mov ax, [si_holder]
mov [esi+0xa], ax
mov ax, [ds_holder]
mov [esi+0xc], ax
mov ax, [es_holder]
mov [esi+0xe], ax
mov ax, [flags_holder]
mov [esi+0x10], ax

popa ;; give all the regs bakc
pop ebp
ret


