pushf

push ax
xor ax, ax
mov ds, ax

pop word [ax_holder]
pop word [flags_holder]

mov [bx_holder], bx
mov [cx_holder], cx
mov [dx_holder], dx
mov [di_holder], di
mov [si_holder], si

mov [ds_holder], ds
mov [es_holder], es


;;now we go back into protected mode
mov eax, cr0
or eax, 1 ; set protected enabled bit
mov cr0, eax
jmp dword 0x08:.Protected_Mode_2nd_Entry

