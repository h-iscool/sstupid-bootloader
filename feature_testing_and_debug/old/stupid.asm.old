jmp 0x18:.into16bitsagain

[bits 16]
.into16bitsagain:

;;no mmore protected mode :(
mov eax, cr0
and eax, ~1 ;; excluding 1 (protected mode bit)
mov cr0, eax

;; far jumps:
jmp 0x0:.realModeAgain

;; ^
;; |
;; |

;;"far"

.realModeAgain:
xor ax,ax
mov ds, ax
mov ss, ax

;; now load the regs again (only 2 more times after thisssssssssssssssssss yay)

mov ax, [ds_holder] ;; ima lose track of ds and es some time in this and will comment down below how many times i broked it and it was this:
mov ds, ax ;; 2
mov ax, [es_holder]
mov es, ax

mov ax, [ax_holder]
mov bx, [bx_holder]
mov cx, [cx_holder]
mov dx, [dx_holder]
mov di, [di_holder]
mov si, [si_holder]



