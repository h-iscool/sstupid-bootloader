disp_help(){
    echo "Compile + Run Help:"
    echo
    echo "Command Syntax:"
    echo "com-run.sh(or alias) <asm> <optional stage2> <optional stage3> <optional stage4> "
    echo
    echo "Run --help or -h to view this screen"
    echo
    echo "THIS COMMAND DOES NOT UTILIZE A LINKER BECAUSE IT IS TO COMPILE AND RUN RAW DISK IMAGES"
    echo "assumes intel syntax, sybau and stop complaining"
}

if [ -z "$1" ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
    disp_help
    exit 0
fi



compileandrun(){
    local asm_file=$1
    local outputfile="out.bin"

    local stage2file=$2
    local stage3file=$3
    local stage4file=$4


    local kvmargs=""
if [ -w /dev/kvm ]; then
    kvmargs="-enable-kvm -cpu host"
else
    kvmargs="-accel tcg,thread=multi -cpu qemu64"
fi

    nasm -f bin -o "catout2.bin" "$asm_file"

    if [ -f "$stage2file" ]; then

        nasm -f bin -o "out2.bin" "$stage2file"
        cat catout2.bin out2.bin > catout.bin

        if [ -f "$stage3file" ]; then

            nasm -f bin -o "out3.bin" "$stage3file"

            cat catout.bin out3.bin > catout2.bin

            if [ -f "$stage4file" ]; then
                nasm -f bin -o "out4.bin" "$stage4file"
                cat catout2.bin out4.bin > catout.bin

            else

                cat catout2.bin > catout.bin

            fi

        fi 

    fi

    cat catout.bin > out.bin

    qemu-system-x86_64 \
  $kvmargs \
  -smp 2 \
  -m 2G \
  -vga virtio -display gtk \
  -drive file="out.bin",if=ide,format=raw \
  -nic user

}



if [ -f "$1" ]; then
    compileandrun "$1" "$2" "$3" "$4"

else
    echo "$1 is not a file"
    exit 1
fi